<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="110dp"
                android:text="@string/app_name"
                android:textAlignment="gravity"
                android:textColor="@color/text_foreground"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawablePadding="5dp"
                android:singleLine="true"
                android:drawableRight="@drawable/ic_arrow_down"
                android:drawableTint="@color/text_sub_foreground"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:paddingHorizontal="14sp"
            android:hint="搜索"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_foreground"
            android:textSize="14sp"
            android:drawableTint="@color/text_sub_foreground"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="8dp"
            android:drawableRight="@drawable/ic_search_18"/>

        <ImageView
            android:id="@+id/iv_collect"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:background="@drawable/bg_circle_dark"
            android:tint="@color/text_foreground"
            android:src="@drawable/ic_collect_48"/>

        <ImageView
            android:id="@+id/iv_history"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:padding="7dp"
            android:background="@drawable/bg_circle_dark"
            android:tint="@color/text_foreground"
            android:src="@drawable/ic_history_48"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            app:tab_indicator_drawable="@drawable/indicator_flash"
            app:tab_indicator_enable_flash="true"
            app:tab_indicator_enable_flash_clip="true"
            app:tab_indicator_height="5dp"
            app:tab_indicator_width="18dp"
            app:tab_select_color="@color/color_theme"
            app:tab_text_min_size="15dp"
            app:tab_text_max_size="17dp"
            app:tab_enable_gradient_text_size="false"
            app:tab_deselect_color="@color/text_sub_foreground"
            app:tab_enable_text_color="true"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="10dp"
            >

        </com.angcyo.tablayout.DslTabLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            />
    </LinearLayout>
</LinearLayout>
