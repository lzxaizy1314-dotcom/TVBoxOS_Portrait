<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:zhy="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_page"
    android:orientation="vertical"
    android:paddingTop="40dp">


    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp"
        >

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="2dp"
            android:src="@drawable/bar_arrows_left_black"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search_18"
                app:tint="@color/text_sub_foreground"/>

            <com.github.tvbox.osc.ui.widget.ClearEditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="搜索影视、演员"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_foreground"
                android:textSize="14sp"
                android:layout_marginHorizontal="8dp"
                android:background="@null"
                android:imeOptions="actionSearch"
                android:inputType="text"
                />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_filter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/text_sub_foreground" />

        <TextView
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_green"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="搜索"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSearchSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        >

        <LinearLayout
            android:id="@+id/ll_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginBottom="24dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索历史"
                    android:textColor="@color/text_foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    />

                <ImageView
                    android:id="@+id/iv_clear_history"
                    android:layout_width="40dp"
                    android:layout_height="24dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="4dp"
                    android:src="@drawable/ic_clear"
                    app:tint="@color/gray_darker"
                    />
            </LinearLayout>

            <com.zhy.view.flowlayout.TagFlowLayout
                android:id="@+id/fl_history"
                zhy:max_select="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
            </com.zhy.view.flowlayout.TagFlowLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="热门搜索"
            android:textColor="@color/text_foreground"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAlignment="viewStart"/>

        <com.zhy.view.flowlayout.TagFlowLayout
            android:id="@+id/fl_hot"
            zhy:max_select="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
        </com.zhy.view.flowlayout.TagFlowLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/llSearchResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tab_draw_highlight="true"
                app:tab_indicator_drawable="@drawable/bg_small_round_gray"
                app:tab_orientation="VERTICAL"
                app:tab_select_color="@color/color_theme"
                app:tab_deselect_color="@color/text_sub_foreground"
                app:tab_enable_text_color="true">

            </com.angcyo.tablayout.DslTabLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_toEndOf="@+id/llWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">


            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_5" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_5" />


        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
